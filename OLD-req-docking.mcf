% -------------------------------------------------------------
% Throughout the docking process the tracker cameras attempt to identify the ISS. (L)
% -------------------------------------------------------------

[p_signal_received(true)] <!p_docking_position(true)* . p_docking_position(false)> true &&
[p_signal_received(true)] <!p_docking_position(true)* . p_docking_position(true)> true
&&

% -------------------------------------------------------------
% The ISS is eventually identified by the tracker cameras. (L)
% -------------------------------------------------------------

[!p_iss_identified(true)*] <true* . p_iss_identified(true)> true
&&

% -------------------------------------------------------------
% The thrusters steer the spacecraft towards the ISS when it is identified. (L)
% -------------------------------------------------------------

[true* . p_iss_identified(true)] <!c_sm_thruster_stop* . a_sm_steer_thrusters> true
&&

% -------------------------------------------------------------
% The thrusters do not fire when the camera has not identified the ISS. (S)
% -------------------------------------------------------------

[!p_iss_identified(true)* . a_sm_steer_thrusters] false
&&

% -------------------------------------------------------------
% The spacecraft does not enter a 200-meter radius of the ISS if it has not received an OK-signal. (S)
% -------------------------------------------------------------

[true* . a_sm_thruster_stop . !p_signal_received(true)* . p_signal_received(true)] <c_sm_thruster_start> true
&&

% -------------------------------------------------------------
% The thrusters only move into docking position after the spacecraft receives the OK signal. (S)
% -------------------------------------------------------------

[!p_signal_received(true)* . p_docking_position(false)] false &&
[!p_signal_received(true)* . p_docking_position(true)] false &&
[true* . p_signal_received(true)] <true* . p_docking_position(true)> true
&&

% -------------------------------------------------------------
% The CM does not attempt docking when the spacecraft is not in docking position. (S)
% -------------------------------------------------------------

[!p_docking_position(true)* . a_cm_lock_doors] false &&
[!a_cm_lock_doors . p_docking_position(true)] <!a_cm_lock_doors* . a_cm_lock_doors> true
&&

% -------------------------------------------------------------
% After the CM has docked the astronauts are able to open the docking door. (L)
% -------------------------------------------------------------

[!a_cm_lock_doors* . a_cm_open_doors] false &&
[true* . a_cm_lock_doors . !a_cm_open_doors*] <a_cm_open_doors> true
